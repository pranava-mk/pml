{
  "name": "pmlkit",
  "version": "0.2.0",
  "description": "Presentations as plain HTML files — visual editor, comments, presenter mode, live reload. AI-native, zero dependencies.",
  "type": "module",
  "bin": {
    "pml": "bin/pml.js"
  },
  "scripts": {
    "start": "node bin/pml.js serve examples",
    "demo": "node bin/pml.js serve examples",
    "sync-app": "cp src/editor/editor.js src/editor/editor.css site/app/",
    "test": "node tests/run.mjs && node tests/verify-slice.mjs",
    "test:slice": "node tests/verify-slice.mjs"
  },
  "keywords": [
    "presentations",
    "slides",
    "html",
    "deck",
    "powerpoint-alternative",
    "claude",
    "ai",
    "markup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranava-mk/pml.git"
  },
  "homepage": "https://presentations-markup-language.vercel.app",
  "bugs": {
    "url": "https://github.com/pranava-mk/pml/issues"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "integration",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Pranava"
}
